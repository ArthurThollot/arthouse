<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Arthouse</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<style>
  :root {
    color-scheme: light dark;
    --accent: #d64545;
    --border: #e2e2e2;
    --muted: #767676;
    --card-bg: canvas;
    --surface: #f7f7f8;
    --shadow: 0 8px 24px rgba(0, 0, 0, 0.13);
    --rating-fill: #2a78d6;
    --rating-track: color-mix(in srgb, var(--rating-fill) 22%, canvas);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      /* The light-mode --border/--muted values are near-white and low-contrast
         respectively once canvas goes dark, so they need real overrides, not
         just a different rating hue. */
      --border: #34353c;
      --muted: #a2a2ac;
      --surface: #191a1f;
      --shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
      --rating-fill: #5b9df0;
    }
  }
  * { box-sizing: border-box; }
  body {
    font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem 4rem;
    line-height: 1.4;
  }

  /* Hero header -- deliberately always-dark, a fixed masthead treatment
     rather than following the light/dark toggle used by the rest of the
     page's functional controls. */
  .hero {
    margin: 0 -1.25rem 1.5rem;
    padding: 2.4rem 1.5rem 2rem;
    background: linear-gradient(135deg, #1a1a24 0%, #3b1620 60%, #4a1f1f 100%);
    color: #f5f0ea;
  }
  .hero-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
  .eyebrow {
    margin: 0 0 0.15rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d9a5a5;
  }
  h1 {
    margin: 0;
    font-family: ui-serif, Georgia, "Iowan Old Style", "Palatino Linotype", serif;
    font-weight: 600;
    font-size: 2.1rem;
    letter-spacing: -0.01em;
    color: #fff;
  }
  .meta { color: #cfc7c0; font-size: 0.88rem; margin-top: 0.6rem; }
  .meta a { color: inherit; }

  .refresh-btn {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.55rem 1.05rem;
    border-radius: 999px;
    border: 1px solid rgba(245, 240, 234, 0.35);
    background: rgba(245, 240, 234, 0.08);
    color: #f5f0ea;
    cursor: pointer;
    white-space: nowrap;
  }
  .refresh-btn:hover:not(:disabled) { background: rgba(245, 240, 234, 0.18); }
  .refresh-btn:disabled { opacity: 0.6; cursor: default; }

  /* Functional controls -- respect light/dark like the rest of the page.
     Sticky so the day/rating/time filters stay reachable while scrolling a
     long grid; compacted onto three rows so it doesn't eat the viewport. */
  .controls {
    position: sticky;
    top: 0;
    z-index: 10;
    background: canvas;
    margin: 0 -1.25rem;
    padding: 0.7rem 1.25rem 0.6rem;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .controls.stuck { border-bottom-color: var(--border); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06); }
  .controls-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .controls-row:last-child { margin-bottom: 0; }

  /* View tabs */
  .view-tabs { display: flex; gap: 0.5rem; flex-shrink: 0; }
  .view-tab {
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--muted);
    cursor: pointer;
  }
  .view-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }

  #filter {
    flex: 1;
    min-width: 180px;
    font-size: 0.95rem;
    padding: 0.5rem 0.75rem;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    color: inherit;
  }

  #reset-btn {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
  }
  #reset-btn:hover { color: var(--accent); border-color: var(--accent); }
  #reset-btn[hidden] { display: none; }

  /* Day pills */
  .day-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pill {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: inherit;
    cursor: pointer;
  }
  .pill.active { background: var(--accent); border-color: var(--accent); color: #fff; }

  /* Sliders -- shared styling, each instance sets --slider-fill/--slider-track inline */
  .slider-filter {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.85rem;
  }
  .slider-filter label { white-space: nowrap; }
  .slider-value { font-weight: 600; display: inline-block; min-width: 4.5em; }
  .range-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 150px;
    max-width: 34vw;
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(to right, var(--slider-fill) 0%, var(--slider-fill) var(--pct, 0%), var(--slider-track) var(--pct, 0%), var(--slider-track) 100%);
    cursor: pointer;
  }
  .range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--slider-fill);
    border: 2px solid var(--card-bg);
    box-shadow: 0 0 0 1px var(--border);
    margin-top: -5px;
  }
  .range-slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--slider-fill);
    border: 2px solid var(--card-bg);
    box-shadow: 0 0 0 1px var(--border);
  }
  .range-slider::-moz-range-track { height: 6px; border-radius: 3px; background: transparent; }

  /* Cinema / bucket filter panels */
  .filter-panels { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .filter-panel {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0;
  }
  .filter-panel[open] { border-color: var(--accent); }
  .filter-panel summary {
    cursor: pointer;
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
    list-style: none;
    white-space: nowrap;
  }
  .filter-panel summary::-webkit-details-marker { display: none; }
  .filter-panel summary::after { content: " \25be"; color: var(--muted); }
  .filter-panel[open] summary::after { content: " \25b4"; }
  .panel-count { color: var(--muted); font-variant-numeric: tabular-nums; }
  /* Absolutely positioned so opening a panel doesn't grow the sticky bar and
     shove the grid down. */
  .filter-panel-body {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: 30;
    padding: 0.6rem 0.8rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: canvas;
    box-shadow: var(--shadow);
    max-height: 340px;
    overflow-y: auto;
    min-width: 230px;
  }
  .filter-panel-actions { margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .filter-panel-actions button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--accent);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .sort-toggle { display: flex; border: 1px solid var(--border); border-radius: 999px; overflow: hidden; }
  .sort-btn {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35rem 0.9rem;
    border: none;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .sort-btn.active { background: var(--accent); color: #fff; }
  .cinema-divider {
    border: none;
    border-top: 1px dashed var(--border);
    margin: 0.4rem 0;
  }
  .filter-panel label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    padding: 0.15rem 0;
    white-space: nowrap;
  }
  /* ~25 genres single-file is a long scroll in a 340px panel, and they're all
     short words -- two columns fits nearly the whole list without scrolling. */
  .genre-list { column-count: 2; column-gap: 1.4rem; }
  .genre-list label { break-inside: avoid; }
  .genre-list .cinema-divider { break-inside: avoid; }

  /* Badges (Last chance) */
  .badge {
    font-size: 0.66rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    margin-right: 0.35rem;
    white-space: nowrap;
    display: inline-block;
    letter-spacing: 0.02em;
  }
  .badge-last { background: color-mix(in srgb, var(--accent) 20%, canvas); color: var(--accent); }

  /* New-release flag -- bare emoji, By Movie tab only (the By Cinema rows are
     dense enough already). Sits after the language tag. */
  /* By Movie tab only -- the By Cinema rows are dense enough already. Sits at
     the end of the meta line, after the runtime, and is loud on purpose. */
  .new-flag {
    display: inline-flex;
    align-items: center;
    gap: 0.22em;
    margin-left: 0.45rem;
    padding: 0.12em 0.5em 0.14em;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    vertical-align: 1px;
  }

  /* By-cinema view */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    align-items: start;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card-bg);
    /* Deliberately not overflow:hidden -- that would make each card its own
       scrollport and kill the sticky header below. */
  }
  .card > details > summary:hover { background: var(--surface); }
  .card > details > summary {
    cursor: pointer;
    list-style: none;
    padding: 0.9rem 1rem 0.7rem;
    /* Pinned just under the sticky control bar so you can still tell which
       column is which cinema after scrolling. --controls-h is measured in JS. */
    position: sticky;
    top: calc(var(--controls-h, 150px) - 1px);
    z-index: 2;
    background: var(--card-bg);
    border-radius: 10px 10px 0 0;
    border-bottom: 1px solid transparent;
  }
  .card > details[open] > summary { border-bottom-color: var(--border); }
  .card > details > summary::-webkit-details-marker { display: none; }
  .card summary .head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
  .card h2 { font-size: 1.05rem; margin: 0; font-family: inherit; }
  .card .twisty { color: var(--muted); font-size: 0.9rem; flex-shrink: 0; }
  .card details[open] .twisty::before { content: "\25be"; }
  .card details:not([open]) .twisty::before { content: "\25b8"; }
  .card .sub {
    color: var(--muted);
    font-size: 0.82rem;
    margin-top: 0.15rem;
  }
  /* Top padding so the first day label isn't glued to the sticky header. */
  .card .body { padding: 0.6rem 1rem 1rem; }
  .day-group { margin-top: 0.6rem; scroll-margin-top: calc(var(--controls-h, 150px) + 3.5rem); }
  .day-group:first-of-type { margin-top: 0; }
  .day-label {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .showtime {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border);
  }
  .showtime:last-child { border-bottom: none; }
  .showtime .time { font-weight: 600; white-space: nowrap; width: 3rem; flex-shrink: 0; padding-top: 0.05rem; }
  .showtime .film-col { flex: 1; min-width: 0; }
  .showtime .film { display: block; }
  .showtime .lang { color: var(--muted); font-size: 0.78rem; white-space: nowrap; }
  a.book { text-decoration: none; color: var(--accent); }
  a.book:hover { text-decoration: underline; }

  .film-details > summary {
    cursor: pointer;
    list-style: none;
  }
  .film-details > summary::-webkit-details-marker { display: none; }
  .film-details > summary .film { text-decoration: underline dotted; text-underline-offset: 3px; text-decoration-color: var(--muted); }
  .film-expanded {
    display: flex;
    gap: 0.6rem;
    margin: 0.5rem 0 0.3rem;
    padding: 0.5rem;
    background: color-mix(in srgb, var(--muted) 10%, canvas);
    border-radius: 6px;
  }
  .film-expanded img {
    width: 56px;
    height: 84px;
    object-fit: cover;
    border-radius: 4px;
    flex-shrink: 0;
    background: var(--border);
  }
  .film-meta { min-width: 0; }
  .film-desc {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .film-credit {
    margin: 0.15rem 0 0;
    font-size: 0.76rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .film-credit strong { color: inherit; font-weight: 600; }

  .rating { display: flex; align-items: center; gap: 0.35rem; margin-top: 0.15rem; }
  .rating-track {
    width: 46px;
    height: 5px;
    border-radius: 3px;
    background: var(--rating-track);
    overflow: hidden;
    flex-shrink: 0;
  }
  .rating-fill { display: block; height: 100%; background: var(--rating-fill); border-radius: 3px; }
  .rating-value { font-size: 0.75rem; color: var(--muted); white-space: nowrap; }

  .empty, #no-results, #no-movie-results { color: var(--muted); font-style: italic; margin-top: 2rem; }
  #no-results, #no-movie-results { display: none; }

  /* By-movie view -- big posters, HBO-style browse grid */
  #movie-view { display: none; }
  .movie-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 1.4rem;
  }
  .movie-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.14s ease, box-shadow 0.14s ease, border-color 0.14s ease;
  }
  .movie-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }
  @media (prefers-reduced-motion: reduce) {
    .movie-card { transition: none; }
    .movie-card:hover { transform: none; }
  }
  /* Placeholder so films OMDb has no poster for don't leave a bare grey box. */
  .movie-card .poster-wrap::before {
    content: "\1F3AC";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    opacity: 0.35;
  }
  .movie-card .poster-wrap img { position: relative; }
  .movie-card .poster-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: var(--border);
    overflow: hidden;
  }
  .movie-card .poster-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .movie-card .poster-badges {
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: flex-start;
  }
  .movie-card .movie-info { padding: 0.8rem 0.9rem 1rem; }
  .movie-card h3 { margin: 0 0 0.25rem; font-size: 1.02rem; font-family: inherit; }
  .movie-card .movie-sub { font-size: 0.78rem; color: var(--muted); margin-bottom: 0.5rem; }
  /* Clamped so the browse grid stays on a tidy baseline instead of every row
     being as tall as its longest synopsis. */
  .movie-card .film-desc {
    margin-top: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Filled in by applyFilters() -- which cinemas this film is actually on at,
     under the filters currently applied. */
  .movie-where {
    font-size: 0.76rem;
    line-height: 1.45;
    margin-top: 0.55rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
  }
  .movie-where strong { color: inherit; font-weight: 600; }
  .movie-where:empty { display: none; }

  /* Keyboard accessibility -- the default outline is invisible on several of
     these custom-styled controls. */
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* --- Map ---------------------------------------------------------------
     Collapsed by default so it never costs vertical space you didn't ask
     for; Leaflet is only booted the first time it's opened. */
  .map-panel { margin-top: 0.9rem; }
  .map-panel > summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--muted);
  }
  .map-panel > summary::-webkit-details-marker { display: none; }
  .map-panel > summary:hover { color: var(--accent); border-color: var(--accent); }
  .map-panel[open] > summary { color: var(--accent); border-color: var(--accent); }
  .map-count { font-variant-numeric: tabular-nums; }
  #cinema-map {
    height: 320px;
    margin-top: 0.7rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    z-index: 0;  /* keep Leaflet's panes below the sticky control bar */
  }
  #map-fallback {
    margin-top: 0.7rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  /* OSM tiles are light-only; invert them (and re-invert nothing else) so the
     map doesn't glare in dark mode. */
  @media (prefers-color-scheme: dark) {
    .leaflet-tile-pane { filter: invert(1) hue-rotate(180deg) brightness(0.92) contrast(0.9); }
  }
  .leaflet-container { font: inherit; background: var(--surface); }
  .map-pin-label {
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
</head>
<body>
<div class="hero">
  <div class="hero-top">
    <div>
      <p class="eyebrow">Amsterdam</p>
      <h1>Arthouse</h1>
    </div>
    <button type="button" id="refresh-btn" class="refresh-btn">&#8635; Refresh</button>
  </div>
  <div class="meta">
    Within {{ radius_km }} km of home &middot; <span id="total-count">{{ total_count }}</span> showtimes across <span id="total-cinemas">{{ cinemas|length }}</span> cinemas
    &middot; generated {{ generated_at }}
  </div>
  <details class="map-panel" id="map-panel">
    <summary>&#128506;&#65039; Map <span class="map-count"></span></summary>
    <div id="cinema-map"></div>
  </details>
</div>

<div class="controls" id="controls">
  <div class="controls-row">
    <div class="view-tabs">
      <button type="button" class="view-tab active" data-view="cinema">&#127916; By Cinema</button>
      <button type="button" class="view-tab" data-view="movie">&#127871; By Movie</button>
    </div>
    <input id="filter" type="search" placeholder="&#128269; Filter by film or cinema&hellip;" autocomplete="off">
    <button type="button" id="reset-btn" hidden>&#10005; Reset filters</button>
  </div>

  <div class="controls-row">
    <div class="day-pills" id="day-pills">
      {% for day in day_pills %}
      <button type="button" class="pill{{ ' active' if day.date == today_iso }}" data-date="{{ day.date }}">{{ day.label }}</button>
      {% endfor %}
    </div>
  </div>

  <div class="controls-row">
    <div class="slider-filter">
      <label for="rating-slider">&#11088; Rating: <span id="rating-slider-value" class="slider-value">Any</span></label>
      <input type="range" id="rating-slider" class="range-slider" style="--slider-fill: var(--rating-fill); --slider-track: var(--rating-track);" min="0" max="10" step="0.1" value="0">
    </div>

    <div class="slider-filter">
      <label for="time-slider"><span id="time-emoji">&#128336;</span> Around: <span id="time-slider-value" class="slider-value">Any time</span></label>
      <input type="range" id="time-slider" class="range-slider" style="--slider-fill: var(--accent); --slider-track: color-mix(in srgb, var(--accent) 20%, canvas);" min="0" max="1439" step="15" value="0">
    </div>

    <div class="filter-panels">
    <details class="filter-panel" id="cinema-panel">
      <summary>&#127916; Cinemas <span class="panel-count" data-count-for="cinema-toggle"></span></summary>
      <div class="filter-panel-body">
        <div class="filter-panel-actions">
          <button type="button" data-action="all">All</button><button type="button" data-action="none">None</button>
          <span class="sort-toggle">
            <button type="button" class="sort-btn active" data-sort="distance">Distance</button><button type="button" class="sort-btn" data-sort="az">A-Z</button>
          </span>
        </div>
        {% for cinema in cinema_checkbox_order %}
        {% if cinema.default_off and not loop.previtem.default_off %}
        <hr class="cinema-divider">
        {% endif %}
        <label data-name="{{ cinema.name|lower }}" data-distance-order="{{ loop.index0 }}">
          <input type="checkbox" class="cinema-toggle" value="{{ cinema.name|lower }}"{{ "" if cinema.default_off else " checked" }}> {{ cinema.name }}
        </label>
        {% endfor %}
      </div>
    </details>

    <details class="filter-panel" id="bucket-panel">
      <summary>&#128692; Bike time <span class="panel-count" data-count-for="bucket-toggle"></span></summary>
      <div class="filter-panel-body">
        <div class="filter-panel-actions">
          <button type="button" data-action="all">All</button><button type="button" data-action="none">None</button>
        </div>
        {% for slug, label in buckets %}
        <label><input type="checkbox" class="bucket-toggle" value="{{ slug }}" checked> {{ label }}</label>
        {% endfor %}
      </div>
    </details>

    {% if genres %}
    <details class="filter-panel" id="genre-panel">
      <summary>&#127917; Genre <span class="panel-count" data-count-for="genre-toggle"></span></summary>
      <div class="filter-panel-body genre-body">
        <div class="filter-panel-actions">
          <button type="button" data-action="all">All</button><button type="button" data-action="none">None</button>
        </div>
        <div class="genre-list">
          {% for genre in genres %}
          <label><input type="checkbox" class="genre-toggle" value="{{ genre|lower }}" checked> {{ genre }}</label>
          {% endfor %}
          {% if has_ungenred %}
          <hr class="cinema-divider">
          <label title="Films OMDb had no match for, so we don't know the genre"><input type="checkbox" class="genre-toggle" value="__unlisted__" checked> Unlisted</label>
          {% endif %}
        </div>
      </div>
    </details>
    {% endif %}
    </div>
  </div>
</div>

{% if not cinemas %}
<p class="empty">No showtimes found. Check config.yaml (radius, allowed_languages, sources) or rerun later.</p>
{% endif %}

<div id="cinema-view">
  <div class="grid" id="grid">
    {% for cinema in cinemas %}
    <div class="card" data-cinema="{{ cinema.name|lower }}" data-bucket="{{ cinema.bucket_slug }}">
      <details open>
        <summary>
          <div class="head">
            <h2>{{ cinema.name }}</h2>
            <span class="twisty"></span>
          </div>
          <div class="sub">{{ cinema.distance_km }} km &middot; ~{{ cinema.bike_minutes }} min bike &middot; <span class="count-label">{{ cinema.count_today }} showtime{{ "s" if cinema.count_today != 1 }}</span></div>
        </summary>
        <div class="body">
          {% for day in cinema.days %}
          <div class="day-group" data-date="{{ day.date }}">
            <div class="day-label">{{ day.label }}</div>
            {% for s in day.showtimes %}
            <div class="showtime" data-film="{{ s.film_title|lower }}" data-rating="{{ s.imdb_rating if s.imdb_rating else '' }}" data-minutes="{{ s.minutes_of_day }}" data-genres="{{ s.genre_slugs|join('|') }}">
              <span class="time">
                {% if s.booking_url %}<a class="book" href="{{ s.booking_url }}">{{ s.time_label }}</a>{% else %}{{ s.time_label }}{% endif %}
              </span>
              <div class="film-col">
                <details class="film-details">
                  <summary>
                    {% if s.is_last_chance %}<span class="badge badge-last">&#8987; Last chance</span>{% endif %}
                    <span class="film">{{ s.film_title }} <span class="lang">{{ s.language_tag }}</span></span>
                  </summary>
                  <div class="film-expanded">
                    {% if s.poster_url %}<img src="{{ s.poster_url }}" alt="" loading="lazy">{% endif %}
                    <div class="film-meta">
                      <p class="film-desc">{{ s.description or "No description available." }}</p>
                      {% if s.genre_display or s.runtime_minutes %}
                      <p class="film-credit">{{ s.genre_display }}{{ " · " if s.genre_display and s.runtime_minutes }}{{ (s.runtime_minutes ~ " min") if s.runtime_minutes }}</p>
                      {% endif %}
                      {% if s.director %}<p class="film-credit"><strong>Director:</strong> {{ s.director }}</p>{% endif %}
                      {% if s.cast %}<p class="film-credit"><strong>Cast:</strong> {{ s.cast }}</p>{% endif %}
                    </div>
                  </div>
                </details>
                {% if s.imdb_rating %}
                <span class="rating" title="IMDb {{ s.imdb_rating }}/10">
                  <span class="rating-track"><span class="rating-fill" style="width: {{ (s.imdb_rating * 10)|round(0, 'floor')|int }}%"></span></span>
                  <span class="rating-value">{{ s.imdb_rating }}</span>
                </span>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
          {% endfor %}
        </div>
      </details>
    </div>
    {% endfor %}
  </div>
  <p id="no-results">No showtimes match the current filters.</p>
</div>

<div id="movie-view">
  <div class="movie-grid" id="movie-grid">
    {% for f in distinct_films %}
    <div class="movie-card" data-film="{{ f.film_title|lower }}">
      <div class="poster-wrap">
        {% if f.poster_url %}<img src="{{ f.poster_url }}" alt="" loading="lazy">{% endif %}
        {% if f.is_last_chance %}
        <div class="poster-badges">
          <span class="badge badge-last">&#8987; Last chance</span>
        </div>
        {% endif %}
      </div>
      <div class="movie-info">
        <h3>{{ f.film_title }}</h3>
        <div class="movie-sub">
          {{ f.language_tag }}{{ " · " ~ f.genre_display if f.genre_display }}{{ (" · " ~ f.runtime_minutes ~ " min") if f.runtime_minutes }}{% if f.is_new %}<span class="new-flag" title="First showing within the last 14 days">&#127381; New</span>{% endif %}
        </div>
        {% if f.imdb_rating %}
        <span class="rating" title="IMDb {{ f.imdb_rating }}/10">
          <span class="rating-track"><span class="rating-fill" style="width: {{ (f.imdb_rating * 10)|round(0, 'floor')|int }}%"></span></span>
          <span class="rating-value">{{ f.imdb_rating }}</span>
        </span>
        {% endif %}
        <p class="film-desc">{{ f.description_full or "No description available." }}</p>
        {% if f.director %}<p class="film-credit"><strong>Director:</strong> {{ f.director }}</p>{% endif %}
        {% if f.cast %}<p class="film-credit"><strong>Cast:</strong> {{ f.cast }}</p>{% endif %}
        <div class="movie-where"></div>
      </div>
    </div>
    {% endfor %}
  </div>
  <p id="no-movie-results" class="empty">No films match the current filters.</p>
</div>

<script>
(function () {
  var searchInput = document.getElementById("filter");
  var dayPills = Array.prototype.slice.call(document.querySelectorAll("#day-pills .pill"));
  var cards = Array.prototype.slice.call(document.querySelectorAll(".card"));
  var movieCards = Array.prototype.slice.call(document.querySelectorAll(".movie-card"));
  var noResults = document.getElementById("no-results");
  var noMovieResults = document.getElementById("no-movie-results");
  var totalCountEl = document.getElementById("total-count");
  var totalCinemasEl = document.getElementById("total-cinemas");
  var ratingSlider = document.getElementById("rating-slider");
  var ratingValueEl = document.getElementById("rating-slider-value");
  var timeSlider = document.getElementById("time-slider");
  var timeValueEl = document.getElementById("time-slider-value");
  var timeEmojiEl = document.getElementById("time-emoji");

  var state = {
    query: "",
    day: document.querySelector("#day-pills .pill.active") ? document.querySelector("#day-pills .pill.active").dataset.date : null,
    minRating: 0,
    targetMinutes: 0,
    cinemas: new Set(Array.prototype.slice.call(document.querySelectorAll(".cinema-toggle")).filter(function (c) { return c.checked; }).map(function (c) { return c.value; })),
    buckets: new Set(Array.prototype.slice.call(document.querySelectorAll(".bucket-toggle")).filter(function (c) { return c.checked; }).map(function (c) { return c.value; })),
    genres: new Set(Array.prototype.slice.call(document.querySelectorAll(".genre-toggle")).filter(function (c) { return c.checked; }).map(function (c) { return c.value; })),
  };

  // A film is usually several genres, so this is an any-of test: ticking
  // "Thriller" keeps a Drama/Thriller. Films with no genre at all (no OMDb
  // match) ride on the separate "Unlisted" box rather than silently always
  // showing -- otherwise ticking one genre would still leave them in.
  var UNLISTED = "__unlisted__";
  function genreOk(row) {
    if (!row._genres) {
      var raw = row.dataset.genres || "";
      row._genres = raw ? raw.split("|") : [];
    }
    if (!row._genres.length) return state.genres.has(UNLISTED);
    for (var i = 0; i < row._genres.length; i++) {
      if (state.genres.has(row._genres[i])) return true;
    }
    return false;
  }

  function applyFilters() {
    var visibleCards = 0;
    var grandTotal = 0;
    // film slug -> { cinemas: Set(display names), count, times: [] }, built from
    // whatever survives the current filters so the By Movie tab can say where a
    // film is actually on rather than just that it exists somewhere this week.
    var visibleFilms = new Map();

    cards.forEach(function (card) {
      var cinemaLabel = card.querySelector("h2") ? card.querySelector("h2").textContent.trim() : card.dataset.cinema;
      var cinemaOk = state.cinemas.has(card.dataset.cinema);
      var bucketOk = state.buckets.has(card.dataset.bucket);
      var cinemaNameMatches = card.dataset.cinema.indexOf(state.query) !== -1;
      var cardHasVisible = false;
      var cardVisibleCount = 0;

      card.querySelectorAll(".day-group").forEach(function (group) {
        var dayOk = cinemaOk && bucketOk && group.dataset.date === state.day;
        var groupHasVisible = false;
        group.querySelectorAll(".showtime").forEach(function (row) {
          var textOk = state.query === "" || cinemaNameMatches || row.dataset.film.indexOf(state.query) !== -1;
          var ratingOk = state.minRating === 0 || (row.dataset.rating !== "" && parseFloat(row.dataset.rating) >= state.minRating);
          var timeOk = state.targetMinutes === 0 || Math.abs(parseInt(row.dataset.minutes, 10) - state.targetMinutes) <= 60;
          var show = dayOk && textOk && ratingOk && timeOk && genreOk(row);
          row.style.display = show ? "" : "none";
          if (show) {
            groupHasVisible = true;
            cardVisibleCount++;
            var info = visibleFilms.get(row.dataset.film);
            if (!info) { info = { cinemas: new Set(), count: 0, times: [] }; visibleFilms.set(row.dataset.film, info); }
            info.cinemas.add(cinemaLabel);
            info.count++;
            var timeEl = row.querySelector(".time");
            if (timeEl) info.times.push(timeEl.textContent.trim());
          }
        });
        group.style.display = groupHasVisible ? "" : "none";
        if (groupHasVisible) cardHasVisible = true;
      });

      var countLabel = card.querySelector(".count-label");
      if (countLabel) countLabel.textContent = cardVisibleCount + " showtime" + (cardVisibleCount !== 1 ? "s" : "");

      card.style.display = cardHasVisible ? "" : "none";
      if (cardHasVisible) { visibleCards++; grandTotal += cardVisibleCount; }
    });

    noResults.style.display = visibleCards === 0 ? "" : "none";
    if (totalCountEl) totalCountEl.textContent = grandTotal;
    if (totalCinemasEl) totalCinemasEl.textContent = visibleCards;

    var visibleMovieCount = 0;
    movieCards.forEach(function (mc) {
      var info = visibleFilms.get(mc.dataset.film);
      mc.style.display = info ? "" : "none";
      if (!info) return;
      visibleMovieCount++;
      var where = mc.querySelector(".movie-where");
      if (where) where.innerHTML = describePlacement(info);
    });
    if (noMovieResults) noMovieResults.style.display = movieCards.length && visibleMovieCount === 0 ? "" : "none";
    updatePanelCounts();
    updateResetVisibility();
    updateMap();
  }

  function escapeHtml(s) {
    return s.replace(/[&<>"]/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
    });
  }

  // "3 showtimes · 18:30, 21:00 · Kriterion, LAB111" -- capped so a film on at
  // eight cinemas doesn't blow the card height out.
  function describePlacement(info) {
    var names = Array.from(info.cinemas).sort();
    var shown = names.slice(0, 3).map(escapeHtml).join(", ");
    if (names.length > 3) shown += " +" + (names.length - 3) + " more";
    var times = info.times.slice().sort();
    var timeBit = times.slice(0, 4).map(escapeHtml).join(", ");
    if (times.length > 4) timeBit += " +" + (times.length - 4);
    return "<strong>" + info.count + " showtime" + (info.count !== 1 ? "s" : "") +
      "</strong> &middot; " + timeBit + "<br>" + shown;
  }

  function updatePanelCounts() {
    document.querySelectorAll(".panel-count").forEach(function (el) {
      var boxes = Array.prototype.slice.call(document.querySelectorAll("." + el.dataset.countFor));
      var on = boxes.filter(function (b) { return b.checked; }).length;
      el.textContent = on === boxes.length ? "(all)" : "(" + on + "/" + boxes.length + ")";
    });
  }

  searchInput.addEventListener("input", function () {
    state.query = searchInput.value.trim().toLowerCase();
    applyFilters();
  });

  dayPills.forEach(function (pill) {
    pill.addEventListener("click", function () {
      dayPills.forEach(function (p) { p.classList.remove("active"); });
      pill.classList.add("active");
      state.day = pill.dataset.date;
      applyFilters();
    });
  });

  function updateRatingSliderUI() {
    var v = parseFloat(ratingSlider.value);
    ratingSlider.style.setProperty("--pct", (v / 10 * 100) + "%");
    ratingValueEl.textContent = v === 0 ? "Any" : v.toFixed(1);
  }
  ratingSlider.addEventListener("input", function () {
    state.minRating = parseFloat(ratingSlider.value);
    updateRatingSliderUI();
    applyFilters();
  });
  updateRatingSliderUI();

  // Unicode clock-face emoji matching the selected time (🕐...🕧), just for fun.
  function clockEmoji(minutes) {
    var h = Math.floor(minutes / 60) % 12;
    var isHalf = (minutes % 60) >= 30;
    var index = h === 0 ? 11 : h - 1;
    var base = isHalf ? 0x1F55C : 0x1F550;
    return String.fromCodePoint(base + index);
  }
  function formatClock(minutes) {
    var h = Math.floor(minutes / 60), m = minutes % 60;
    return (h < 10 ? "0" : "") + h + ":" + (m < 10 ? "0" : "") + m;
  }
  function updateTimeSliderUI() {
    var v = parseInt(timeSlider.value, 10);
    timeSlider.style.setProperty("--pct", (v / 1439 * 100) + "%");
    if (v === 0) {
      timeValueEl.textContent = "Any time";
      timeEmojiEl.textContent = "\u{1F550}";
    } else {
      timeValueEl.textContent = "~" + formatClock(v);
      timeEmojiEl.textContent = clockEmoji(v);
    }
  }
  timeSlider.addEventListener("input", function () {
    state.targetMinutes = parseInt(timeSlider.value, 10);
    updateTimeSliderUI();
    applyFilters();
  });
  updateTimeSliderUI();

  function wireCheckboxGroup(panelId, checkboxClass, targetSet) {
    var panel = document.getElementById(panelId);
    var boxes = Array.prototype.slice.call(panel.querySelectorAll("." + checkboxClass));
    boxes.forEach(function (box) {
      box.addEventListener("change", function () {
        if (box.checked) targetSet.add(box.value); else targetSet.delete(box.value);
        applyFilters();
      });
    });
    panel.querySelectorAll(".filter-panel-actions > button").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var check = btn.dataset.action === "all";
        boxes.forEach(function (box) {
          box.checked = check;
          if (check) targetSet.add(box.value); else targetSet.delete(box.value);
        });
        applyFilters();
      });
    });
  }

  function wireSortToggle(panelId) {
    var panel = document.getElementById(panelId);
    var body = panel.querySelector(".filter-panel-body");
    var labels = Array.prototype.slice.call(body.querySelectorAll("label"));
    var buttons = Array.prototype.slice.call(panel.querySelectorAll(".sort-btn"));
    if (!buttons.length) return;
    buttons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        buttons.forEach(function (b) { b.classList.remove("active"); });
        btn.classList.add("active");
        var sorted = labels.slice().sort(function (a, b) {
          if (btn.dataset.sort === "az") {
            return a.dataset.name.localeCompare(b.dataset.name);
          }
          return parseInt(a.dataset.distanceOrder, 10) - parseInt(b.dataset.distanceOrder, 10);
        });
        sorted.forEach(function (label) { body.appendChild(label); });
        panel.querySelectorAll(".cinema-divider").forEach(function (hr) { hr.remove(); });
      });
    });
  }

  wireCheckboxGroup("cinema-panel", "cinema-toggle", state.cinemas);
  wireCheckboxGroup("bucket-panel", "bucket-toggle", state.buckets);
  if (document.getElementById("genre-panel")) {
    wireCheckboxGroup("genre-panel", "genre-toggle", state.genres);
  }
  wireSortToggle("cinema-panel");

  var viewTabs = Array.prototype.slice.call(document.querySelectorAll(".view-tab"));
  var cinemaView = document.getElementById("cinema-view");
  var movieView = document.getElementById("movie-view");
  viewTabs.forEach(function (tab) {
    tab.addEventListener("click", function () {
      viewTabs.forEach(function (t) { t.classList.remove("active"); });
      tab.classList.add("active");
      var isMovie = tab.dataset.view === "movie";
      // "" would fall back to the stylesheet's own default, and #movie-view's
      // default is display:none -- so showing it needs an explicit value.
      cinemaView.style.display = isMovie ? "none" : "block";
      movieView.style.display = isMovie ? "block" : "none";
    });
  });

  // --- Reset filters -------------------------------------------------------
  var allBoxes = Array.prototype.slice.call(document.querySelectorAll(".cinema-toggle, .bucket-toggle, .genre-toggle"));
  var initialDay = state.day;
  var resetBtn = document.getElementById("reset-btn");

  function isDirty() {
    if (state.query !== "" || state.day !== initialDay) return true;
    if (state.minRating !== 0 || state.targetMinutes !== 0) return true;
    return allBoxes.some(function (b) { return b.checked !== b.defaultChecked; });
  }
  function updateResetVisibility() {
    if (resetBtn) resetBtn.hidden = !isDirty();
  }
  if (resetBtn) {
    resetBtn.addEventListener("click", function () {
      searchInput.value = "";
      state.query = "";
      ratingSlider.value = 0;
      state.minRating = 0;
      updateRatingSliderUI();
      timeSlider.value = 0;
      state.targetMinutes = 0;
      updateTimeSliderUI();
      dayPills.forEach(function (p) {
        p.classList.toggle("active", p.dataset.date === initialDay);
      });
      state.day = initialDay;
      allBoxes.forEach(function (b) {
        b.checked = b.defaultChecked;
        var set = b.classList.contains("cinema-toggle") ? state.cinemas
                : b.classList.contains("genre-toggle") ? state.genres
                : state.buckets;
        if (b.checked) set.add(b.value); else set.delete(b.value);
      });
      applyFilters();
    });
  }

  // --- Sticky control bar: shadow only once it's actually pinned -----------
  var controlsEl = document.getElementById("controls");
  if (controlsEl) {
    var sentinel = document.createElement("div");
    controlsEl.parentNode.insertBefore(sentinel, controlsEl);
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        controlsEl.classList.toggle("stuck", !entries[0].isIntersecting);
      }).observe(sentinel);
    }
    // Publish the bar's real height so the sticky cinema headers and the
    // scroll-into-view offsets can sit just below it. It changes with viewport
    // width (the control rows wrap), so re-measure on resize.
    var syncControlsHeight = function () {
      document.documentElement.style.setProperty(
        "--controls-h", controlsEl.offsetHeight + "px");
    };
    syncControlsHeight();
    window.addEventListener("resize", syncControlsHeight);
  }

  // --- Map -----------------------------------------------------------------
  // Cinema coordinates come straight from the source APIs (Pathé and
  // Cineville both return lat/lon on their venue records).
  var CINEMA_GEO = [
    {% for c in cinemas -%}
    { name: {{ c.name | tojson }}, key: {{ c.name|lower | tojson }}, lat: {{ c.lat | tojson }}, lon: {{ c.lon | tojson }}, bike: {{ c.bike_minutes | tojson }}, km: {{ c.distance_km | tojson }} }{{ "," if not loop.last }}
    {% endfor -%}
  ];
  var HOME = { lat: {{ home.lat }}, lon: {{ home.lon }} };

  var mapPanel = document.getElementById("map-panel");
  var mapCount = document.querySelector(".map-count");
  var map = null;
  var markerLayer = null;

  // Which cinemas survive the current filters -- read off the cards so the map
  // can never drift out of sync with the grid.
  function visibleCinemaKeys() {
    var keys = [];
    document.querySelectorAll(".card").forEach(function (c) {
      if (c.style.display !== "none") keys.push(c.dataset.cinema);
    });
    return keys;
  }

  function initMap() {
    if (map || !mapPanel.open) return;
    if (!window.L) {  // CDN blocked or offline
      if (!document.getElementById("map-fallback")) {
        var p = document.createElement("p");
        p.id = "map-fallback";
        p.textContent = "Map unavailable -- couldn't load Leaflet (no internet?).";
        document.getElementById("cinema-map").replaceWith(p);
      }
      return;
    }
    map = L.map("cinema-map", { scrollWheelZoom: false });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);
    L.circleMarker([HOME.lat, HOME.lon], {
      radius: 8, color: "#fff", weight: 3, fillColor: "#222", fillOpacity: 1
    }).addTo(map).bindTooltip("Home", { permanent: true, direction: "top", className: "map-pin-label" });
    markerLayer = L.layerGroup().addTo(map);
    drawMarkers();
  }

  function drawMarkers() {
    if (!map || !markerLayer) return;
    markerLayer.clearLayers();
    var shown = visibleCinemaKeys();
    var pts = [[HOME.lat, HOME.lon]];
    CINEMA_GEO.forEach(function (c) {
      if (shown.indexOf(c.key) === -1 || c.lat == null || c.lon == null) return;
      pts.push([c.lat, c.lon]);
      L.circleMarker([c.lat, c.lon], {
        radius: 7, color: "#fff", weight: 2,
        fillColor: getComputedStyle(document.documentElement).getPropertyValue("--accent").trim() || "#d64545",
        fillOpacity: 1
      }).addTo(markerLayer).bindTooltip(
        c.name + " -- " + c.km + " km, ~" + c.bike + " min bike",
        { direction: "top", className: "map-pin-label" }
      );
    });
    if (pts.length > 1) map.fitBounds(pts, { padding: [30, 30] });
    else map.setView([HOME.lat, HOME.lon], 13);
  }

  function updateMap() {
    var n = visibleCinemaKeys().length;
    if (mapCount) mapCount.textContent = "(" + n + ")";
    drawMarkers();
  }

  if (mapPanel) {
    mapPanel.addEventListener("toggle", function () {
      if (!mapPanel.open) return;
      initMap();
      // Leaflet mis-measures a container that was display:none at init time.
      if (map) setTimeout(function () { map.invalidateSize(); drawMarkers(); }, 0);
    });
  }

  // --- Close filter dropdowns on outside click / Escape --------------------
  var panels = Array.prototype.slice.call(document.querySelectorAll(".filter-panel"));
  document.addEventListener("click", function (e) {
    panels.forEach(function (p) { if (p.open && !p.contains(e.target)) p.open = false; });
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") panels.forEach(function (p) { p.open = false; });
  });

  var refreshBtn = document.getElementById("refresh-btn");
  if (refreshBtn) {
    if (location.protocol === "file:") {
      // Opened the file directly rather than via ./run.sh -- there's no
      // server behind /refresh, so don't let the user click into a
      // failure. Explain up front instead.
      refreshBtn.disabled = true;
      refreshBtn.title = "Only works when served via ./run.sh (not when opening this file directly)";
    } else {
      refreshBtn.addEventListener("click", function () {
        refreshBtn.disabled = true;
        refreshBtn.textContent = "Refreshing…";
        fetch("/refresh", { method: "POST" })
          .then(function (r) {
            if (!r.ok) throw new Error("refresh failed");
            location.reload();
          })
          .catch(function () {
            refreshBtn.disabled = false;
            refreshBtn.innerHTML = "&#8635; Refresh";
            alert("Refresh failed -- is ./run.sh still running in a terminal?");
          });
      });
    }
  }

  applyFilters();
})();
</script>

</body>
</html>
